# API
PORT=4000
DATABASE_URL=postgresql://financial:financial@localhost:5432/financial_companion
REDIS_URL=redis://localhost:6379
AUTH_MODE=development
CORS_ORIGIN=http://localhost:8081,http://localhost:3000
INVESTMENT_EXPLORER_ENABLED=true

# Mobile (public, never place secrets here)
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_INVESTMENT_EXPLORER_ENABLED=true
# Development only: route API calls through Metro, including Expo tunnels.
EXPO_PUBLIC_USE_DEV_SERVER_API=false
EXPO_METRO_API_PROXY=false
EXPO_METRO_API_PROXY_PORT=4000

# Portal
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
RESEND_API_KEY=
BETA_SIGNUP_FROM=Finli Beta <beta@your-verified-domain.com>
BETA_SIGNUP_TO=beta@financialcompanion.app
